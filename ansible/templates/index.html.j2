<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ ansible_hostname }}</title>
    <style>
        body { font-family: 'Arial', sans-serif; text-align: center; padding: 50px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .container { background: rgba(255,255,255,0.9); padding: 40px; border-radius: 10px; display: inline-block; color: #333; }
        h1 { color: #667eea; }
        .info { background: #f5f5f5; padding: 20px; border-radius: 5px; margin: 20px 0; }
        .hostname { color: #27ae60; font-weight: bold; font-size: 1.2em; }
        .badge { background: #667eea; color: white; padding: 5px 10px; border-radius: 20px; display: inline-block; margin: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚀 Servidor Web HA en GCP</h1>
        <div class="info">
            <p><span class="badge">Hostname</span> <span class="hostname">{{ ansible_hostname }}</span></p>
            <p><span class="badge">IP Privada</span> {{ ansible_default_ipv4.address }}</p>
            <p><span class="badge">Sistema</span> {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
            <p><span class="badge">Arquitectura</span> {{ ansible_architecture }}</p>
        </div>
        <p><small>Configurado con Ansible • Certificado SSL autofirmado</small></p>
        <p><small>Proyecto HA - {{ ansible_date_time.date }}</small></p>
    </div>
</body>
</html>
